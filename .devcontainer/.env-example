# 
# Model file for actual .env file
# Non-secret or non-local data has not been masked
# since there is no reason to do that
#
EXTERNAL_MODEL_PATH="/path/to/ollama-models" # Replace with actual value


RAG_OLLAMA_CONFIGURATION_HOST="http://ollama:11434"

RAG_EMBED_CONFIGURATION_MODEL="nomic-embed-text" 

RAG_CHAT_CONFIGURATION_MODEL="qwen_3_6b_deterministic"
 
RAG_VECTOR_DB_POSTGRES_HOST="postgres"
RAG_VECTOR_DB_POSTGRES_DB="rag"
RAG_VECTOR_DB_POSTGRES_USER="rag"
RAG_VECTOR_DB_POSTGRES_PASSWORD="my-rag-password" # Replace with actual value
RAG_VECTOR_DB_POSTGRES_DATA_FOLDER="/path/to/postgres-data" # Replace with actual value