{
    "name": "rag-platform-env",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "target": "rag-image"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "runArgs": [
        "--env-file",
        ".devcontainer/.env"
    ],
    "mounts": [
        "source=/Volumes/DOCKER/ollama-models,target=/mnt/models,type=bind"
    ],
    "postCreateCommand": "./env-display.sh",
    "remoteUser": "vscode"
}