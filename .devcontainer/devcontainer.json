{
    "name": "rag-platform-env",
    // "build": {
    //     "dockerfile": "Dockerfile",
    //     "context": "..",
    //     "target": "rag-image"
    // },
    "workspaceFolder": "/workspace",
    "dockerComposeFile": [
        "docker-compose.yml"
    ],
    "service": "dev",
    "runServices": [
        "ollama"
    ],
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    // "runArgs": [
    //     "--env-file",
    //     ".devcontainer/.env"
    // ],
    "mounts": [
        "source=/Volumes/DOCKER/ollama-models,target=/mnt/models,type=bind"
    ],
    "postCreateCommand": "./env-display.sh",
    "remoteUser": "vscode"
}