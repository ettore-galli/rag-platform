{
    "name": "rag-platform-env",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "target": "rag-image"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "runArgs": [
        "--env-file",
        ".devcontainer/.env"
    ],
    // "postCreateCommand": "echo 'DEBUG: HF_USERNAME=' $HF_USERNAME && echo 'DEBUG: HF_TOKEN is set' && bash /usr/local/bin/download-model.sh",
    "remoteUser": "vscode",
