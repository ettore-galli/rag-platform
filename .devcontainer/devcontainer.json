{
    "name": "rag-platform-env",
    "workspaceFolder": "/workspace",
    "dockerComposeFile": [
        "docker-compose.yml"
    ],
    "service": "dev",
    "runServices": [
        "ollama",
        "postgres"
    ],
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "be5invis.toml",
                "ms-python.black-formatter",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.vscode-python-envs"
            ]
        }
    },
    "mounts": [
        "source=/Volumes/DOCKER/ollama-models,target=/mnt/models,type=bind"
    ],
    "postCreateCommand": "./env-display.sh",
    "remoteUser": "vscode"
}